# =============================================================================
# sovereign-rag configuration: single source of truth for every setting.
# Copy to .env at the repo root, then: docker compose up
# Every key below mirrors a field of backend/src/sovereign_rag/config.py
# (Settings); backend/tests/test_env_example.py fails if this file drifts.
# =============================================================================

# --- Docker Compose ----------------------------------------------------------
# Read by docker compose itself (not by the app): "ollama" starts the local LLM
# services; set it empty to disable them and use an external provider instead.
COMPOSE_PROFILES=ollama
# Host port the compose postgres service binds to; change it if another
# PostgreSQL already owns 5432 on your machine.
POSTGRES_HOST_PORT=5432

# --- Application ---------------------------------------------------------------
# "dev" or "prod"; prod switches logs to JSON and forbids empty AUTH_API_KEYS
APP_ENV=dev
# log verbosity: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
# Postgres DSN; docker-compose overrides the host with the postgres service name
DATABASE_URL=postgresql://rag:rag@localhost:5432/rag

# --- LLM provider: ollama (default) --------------------------------------------
# data leaves your infra: no
# which chat backend to use: ollama | openai_compatible | azure_openai
LLM_PROVIDER=ollama
# where the Ollama server listens (compose overrides with http://ollama:11434)
OLLAMA_BASE_URL=http://localhost:11434
# chat model, pulled once by the ollama-pull one-shot service
OLLAMA_MODEL=qwen3:4b-instruct
# keep the model loaded in memory between questions
OLLAMA_KEEP_ALIVE=10m
# disable qwen3 <think> blocks (native API flag; keeps demo latency low)
OLLAMA_THINK=false

# --- LLM provider: openai_compatible (vLLM, Infomaniak AI Tools, Mistral...) ---
# data leaves your infra: depends on where the endpoint runs (yes for hosted APIs)
# base URL of any OpenAI-compatible endpoint; leave empty unless used
OPENAI_COMPAT_BASE_URL=
# API key for that endpoint; leave empty unless used
OPENAI_COMPAT_API_KEY=
# model name as exposed by the endpoint; leave empty unless used
OPENAI_COMPAT_MODEL=

# --- LLM / embeddings provider: azure_openai -----------------------------------
# data leaves your infra: yes (processed in your Azure OpenAI resource's region)
# https://<resource>.openai.azure.com ; leave empty unless used
AZURE_OPENAI_ENDPOINT=
# API key auth; leave empty to use azure-identity (requires: uv sync --extra azure)
AZURE_OPENAI_API_KEY=
# chat model deployment name; leave empty unless used
AZURE_OPENAI_CHAT_DEPLOYMENT=
# embedding model deployment name; leave empty unless used
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=
# Azure OpenAI API version
AZURE_OPENAI_API_VERSION=2024-10-21

# --- Embeddings -----------------------------------------------------------------
# WARNING (FROZEN MODEL): switching embedding models or dimensions invalidates
# the whole vector index; the app refuses to boot on a mismatch. Changing this
# requires a migration (vector(N)) and a full re-ingestion. See README.
# data leaves your infra: no (local) / yes (azure_openai)
# embeddings backend: local (in-process sentence-transformers) | azure_openai
EMBEDDING_PROVIDER=local
# embedding model id (multilingual, 384 dims, CPU-friendly)
EMBEDDING_MODEL=intfloat/multilingual-e5-small
# must match the model's output dimensions AND the vector(N) column
EMBEDDING_DIMENSIONS=384

# --- Retrieval ------------------------------------------------------------------
# vector store backend (pgvector only in Phase 1)
VECTOR_STORE=pgvector
# chunk size in characters (~300 tokens)
CHUNK_SIZE=1200
# overlap between consecutive chunks, in characters
CHUNK_OVERLAP=200
# number of fused chunks handed to the LLM
RETRIEVAL_TOP_K=8
# per-leg candidate count before RRF fusion
RETRIEVAL_CANDIDATES=40
# RRF constant (default from the original paper)
RRF_K=60
# pgvector HNSW runtime search width; must be >= RETRIEVAL_CANDIDATES
HNSW_EF_SEARCH=80

# --- Auth (Phase 1: static API keys) --------------------------------------------
# JSON map api_key -> user_id; DEMO VALUES, replace before any real deployment
AUTH_API_KEYS={"sk-demo":"demo","sk-demo-admin":"admin"}
# JSON list of user_ids granted the admin role
AUTH_ADMIN_USERS=["admin"]

# --- Misc ------------------------------------------------------------------------
# reject uploads larger than this (MB)
MAX_UPLOAD_MB=25
# JSON list of allowed browser origins (Vite dev server default)
CORS_ORIGINS=["http://localhost:5173"]
# ingest data/demo/ at boot when the documents table is empty (idempotent)
SEED_DEMO_DATA=true
# demo corpus directory; relative paths resolve against backend/
DEMO_DATA_DIR=../data/demo
